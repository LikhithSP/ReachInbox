# ReachInbox Environment Variables Template
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# Database (MySQL via Prisma)
# In development without Docker, SQLite can be used (e.g., file:./dev.db)
DATABASE_URL="mysql://reachinbox:reachinbox_pass@localhost:3306/reachinbox"

# Queue / Cache (Redis via BullMQ & IORedis)
REDIS_URL="redis://localhost:6379"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4000/api/v1/auth/google/callback"

# Session / JWT Secrets
SESSION_SECRET="super-secret-session-key-reachinbox-scheduler-change-me"
JWT_SECRET="super-secret-jwt-key-reachinbox-scheduler-change-me"

# Slack OAuth & Integration
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""
SLACK_REDIRECT_URI="http://localhost:4000/api/v1/integrations/slack/callback"
SLACK_SIGNING_SECRET=""
SLACK_NOTIFICATION_CHANNEL="#email-alerts"

# SMTP Delivery (Ethereal Email for testing/demo)
SMTP_HOST="smtp.ethereal.email"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="ReachInbox Scheduler <scheduler@reachinbox.ai>"

# Elasticsearch (Optional / Local Search Index)
ELASTICSEARCH_URL="http://localhost:9200"
ELASTICSEARCH_USERNAME=""
ELASTICSEARCH_PASSWORD=""
ELASTICSEARCH_INDEX="email_jobs"

# Worker & Scheduler Configuration
WORKER_CONCURRENCY=5
MIN_EMAIL_DELAY_MS=2000
MAX_EMAILS_PER_HOUR=100

# Bull Board Dashboard
ENABLE_BULL_BOARD=true
BULL_BOARD_PATH="/admin/queues"
