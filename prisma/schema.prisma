datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum EmailJobStatus {
  SCHEDULED
  QUEUED
  PROCESSING
  SENT
  FAILED
  RATE_LIMITED
}

model User {
  id              String           @id @default(uuid())
  googleId        String           @unique
  email           String           @unique
  name            String
  avatarUrl       String?          @db.Text
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  campaigns       Campaign[]
  senders         Sender[]
  slackConnection SlackConnection?

  @@index([googleId])
  @@index([email])
  @@map("users")
}

model Sender {
  id        String     @id @default(uuid())
  userId    String
  email     String
  provider  String     @default("ethereal")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailJobs EmailJob[]

  @@index([userId])
  @@map("senders")
}

model Campaign {
  id              String     @id @default(uuid())
  userId          String
  subject         String
  body            String     @db.Text
  startTime       DateTime
  delayMs         Int        @default(2000)
  hourlyLimit     Int        @default(100)
  totalRecipients Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailJobs       EmailJob[]

  @@index([userId])
  @@index([createdAt])
  @@map("campaigns")
}

model EmailJob {
  id             String         @id @default(uuid())
  campaignId     String
  senderId       String
  recipient      String
  subject        String
  body           String         @db.Text
  scheduledAt    DateTime
  status         EmailJobStatus @default(SCHEDULED)
  bullJobId      String?
  idempotencyKey String         @unique
  attempts       Int            @default(0)
  processingAt   DateTime?
  sentAt         DateTime?
  failedAt       DateTime?
  errorMessage   String?        @db.Text
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sender   Sender   @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([senderId])
  @@index([status])
  @@index([scheduledAt])
  @@index([recipient])
  @@index([idempotencyKey])
  @@map("email_jobs")
}

model SlackConnection {
  id             String   @id @default(uuid())
  userId         String   @unique
  teamId         String
  teamName       String
  channelId      String
  encryptedToken String   @db.Text
  connectedAt    DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("slack_connections")
}
